## Copy this file to .env in the repository root.
## Real/demo mode is the default. Set either flag to true only intentionally.
USE_MOCK=false
USE_MOCK_AGENT=false

## Local service URLs (ports match README.md and docs/architecture.md).
ORCHESTRATOR_URL=http://localhost:8000
DOC_PROCESSOR_URL=http://localhost:8001
RETRIEVAL_URL=http://localhost:8002
RETRIEVAL_API_URL=http://localhost:8002
AGENT_SERVICE_URL=http://localhost:8003
ANSWER_VALIDATOR_URL=http://localhost:8004

## Durable ingestion state. Relative paths are avoided so service cwd is irrelevant.
# CORPUS_MANIFEST_PATH=C:/absolute/path/to/ledger-financial-document-intelligence/data/corpus-manifest.json

## Configure the provider used by agent-service.
GROQ_API_KEY=
# GOOGLE_API_KEY=
