## Copy this file to .env in the repository root.
## Real/demo mode is the default. Set either flag to true only intentionally.
USE_MOCK=false
USE_MOCK_AGENT=false

## Local service URLs (ports match README.md and docs/architecture.md).
ORCHESTRATOR_URL=http://localhost:8000
DOC_PROCESSOR_URL=http://localhost:8001
RETRIEVAL_URL=http://localhost:8002
RETRIEVAL_API_URL=http://localhost:8002
AGENT_SERVICE_URL=http://localhost:8003
ANSWER_VALIDATOR_URL=http://localhost:8004
EVAL_SERVICE_URL=http://localhost:8005

## Held-out evaluation and Langfuse. Use absolute paths when services have
## different working directories.
# EVAL_DATASET_PATH=C:/absolute/path/to/data/questions_setA_practice.json
# EVAL_DATA_DIR=C:/absolute/path/to/data/evaluation
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_REQUIRED=false
LANGFUSE_TRACING_ENABLED=true

## Durable ingestion state. Relative paths are avoided so service cwd is irrelevant.
# CORPUS_MANIFEST_PATH=C:/absolute/path/to/ledger-financial-document-intelligence/data/corpus-manifest.json

## Configure the provider used by agent-service.
GROQ_API_KEY=
AGENT_MODEL=qwen/qwen3.8-27b
AGENT_PROVIDER=groq
AGENT_PROMPT_VERSION=graph-v1
# Copy the provider's current USD prices. Leaving both at zero records cost as unavailable.
LLM_INPUT_COST_PER_MILLION=0
LLM_OUTPUT_COST_PER_MILLION=0
LLM_PRICE_SOURCE=unconfigured
LLM_PRICE_EFFECTIVE_DATE=unconfigured
# GOOGLE_API_KEY=
